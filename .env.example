# Copie para .env e ajuste conforme necessário.

# URL da API. Em desenvolvimento, o Vite faz proxy de /api para cá, de modo que
# o cookie de sessão trafega sob a mesma origem (ADR-0013 §8, ADR-0017 §9).
VITE_API_URL=http://localhost:3000

# Mantenha false para usar a demonstração com dados locais; true autentica e usa a API.
VITE_USE_BACKEND=false

# Prefixo HTTP da API e nome do cookie anti-CSRF legível pelo navegador.
VITE_API_BASE_URL=/api/v1
VITE_CSRF_COOKIE_NAME=vince_csrf

# Especificação OpenAPI de onde os tipos são derivados (ADR-0017 §2).
API_SPEC_URL=http://localhost:3000/api/openapi.json
