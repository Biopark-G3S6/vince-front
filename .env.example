# Copie para .env e ajuste conforme necessário.

# URL da API. Em desenvolvimento, o Vite faz proxy de /api para cá, de modo que
# o cookie de sessão trafega sob a mesma origem (ADR-0013 §8, ADR-0017 §9).
VITE_API_URL=http://localhost:3000

# Especificação OpenAPI de onde os tipos são derivados (ADR-0017 §2).
API_SPEC_URL=http://localhost:3000/api/v1/openapi.json
